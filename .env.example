# Environment Variables for Project Spider-Sense
# Copy this file to .env or .env.local to configure your environment.

# Database URL:
# For production (e.g. Neon, Supabase, Render, Vercel Postgres):
DATABASE_URL="postgresql://spiderman:webshooter123@localhost:5432/spidersense?schema=public"

# GenAI Integration (Provide at least one, or use the built-in Spider-Sense Offline Engine):
# Option A: OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=""

# Option B: Google Gemini API Key (Gemini 2.5 / 1.5 Flash)
GEMINI_API_KEY=""

# Optional Next.js public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
