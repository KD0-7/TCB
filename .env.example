# Environment Variables for Project Spider-Sense
# Copy this file to .env or .env.local to configure your environment.

# Database URL:
# For PostgreSQL (Neon / Supabase / Render / Vercel Postgres):
DATABASE_URL="postgresql://user:password@localhost:5432/spidersense?schema=public"

# ==========================================
# GenAI Providers (Cloud & Multimodal Vision)
# ==========================================

# Option A: Google Gemini API (Recommended for Multimodal Vision & Reasoning)
# Supports Gemini 1.5 Flash / 2.5 with image and handwriting recognition
GEMINI_API_KEY=""

# Option B: OpenAI API (GPT-4o / GPT-4o-mini Vision)
OPENAI_API_KEY=""

# ==========================================
# Local LLM Support (Ollama / Local Inference)
# ==========================================
# Run models locally for 100% privacy and zero API costs:
# e.g. ollama run llama3.2
OLLAMA_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3.2"

# Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
