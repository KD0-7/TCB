// Prisma Schema for Project Spider-Sense
// Dual-phase task management tool (Peter Parker vs Spider-Man)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  PETER
  SPIDER
}

enum Status {
  PENDING
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  mode        Mode      @default(PETER)
  status      Status    @default(PENDING)
  priority    Priority  @default(MEDIUM)
  category    String?   // e.g. "Oscorp", "Daily Bugle", "Family", "Health", "Avengers"
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([mode])
  @@index([status])
}
