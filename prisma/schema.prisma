// Prisma Schema for Project Spider-Sense
// Dual-phase task management tool for everyday people (Themed with Spider-Man work-life balance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  PETER   // Personal, Family, Self-Care, Errands, Health, Hobbies
  SPIDER  // Work, Career, Deadlines, Deep Work, High-Priority Deliverables
}

enum Status {
  PENDING
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  mode         Mode      @default(PETER)
  status       Status    @default(PENDING)
  priority     Priority  @default(MEDIUM)
  category     String?   // e.g. "Work / Engineering", "Personal / Health", "Finance", "Family"
  deadline     DateTime?
  reminderTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([mode])
  @@index([status])
}
